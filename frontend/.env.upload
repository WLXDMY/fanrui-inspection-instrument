NODE_ENV = production
ENV = 'production'

# 凡瑞小程序测试上传模式：只显示检验仪器模块，并使用可移植的相对资源路径和 Hash 路由。
VUE_APP_UPLOAD_PACKAGE = true
VUE_APP_STANDALONE_UPLOAD = true
VUE_APP_LOCAL_SOURCE_PREVIEW = true
VUE_APP_NGINX_PATH = /factory/v1

# 独立扩展后端当前使用单独端口。上传测试时请求会复用凡瑞登录 Token。
VUE_APP_INSTRUMENT_EXTENSION_API = '/instrument-extension/api/v1'

# 保留动态 import，确保仅在打开检验仪器子页面时加载对应代码。
VUE_CLI_BABEL_TRANSPILE_MODULES = false
